{
    "name": "@palasthotel/additional-authors",
    "private": true,
    "description": "Assign more than one author to a post.",
    "license": "GPL-3.0-or-later",
    "author": {
        "name": "Palasthotel",
        "email": "webmaster@palasthotel.de",
        "url": "https://palasthotel.de"
    },
    "repository": "git+https://github.com/palasthotel/wp-additional-authors.git",
    "bugs": {
        "url": "https://github.com/palasthotel/wp-additional-authors/issues"
    },
    "scripts": {
        "lint": "tsc --noEmit",
        "build": "npm run build:scripts && npm run build:blocks",
        "build:scripts": "wp-scripts build --output-path=./public/build gutenberg=./src/gutenberg.js meta-box=./src/meta-box.js users-table=./src/users-table.ts",
        "build:blocks": "wp-scripts build --webpack-src-dir=./src-blocks --output-path=./public/build/blocks",
        "start:blocks": "wp-scripts start --webpack-src-dir=./src-blocks --output-path=./public/build/blocks",
        "pack": "SLUG=additional-authors bash ../github-workflows/wp-plugin/bin/pack.sh"
    },
    "devDependencies": {
        "@types/wordpress__block-editor": "^15.0.7",
        "@types/wordpress__blocks": "^15.17.0",
        "@wordpress/block-editor": "^18.1.0",
        "@wordpress/blocks": "^17.0.0",
        "@wordpress/components": "^43.0.0",
        "@wordpress/data": "^10.57.0",
        "@wordpress/editor": "^16.0.0",
        "@wordpress/element": "^10.0.0",
        "@wordpress/icons": "^18.0.0",
        "@wordpress/plugins": "^7.57.0",
        "@wordpress/scripts": "^37.0.0",
        "prop-types": "^15.8.1",
        "react": "^19.3.0",
        "react-dom": "^19.3.1",
        "typescript": "^7.0.2",
        "underscore": "^1.13.8"
    }
}
