{
    "name": "@palasthotel/additional-authors",
    "version": "1.3.9",
    "private": true,
    "scripts": {
        "lint": "tsc --noEmit",
        "build": "npm run build:scripts && npm run build:blocks",
        "build:scripts": "wp-scripts build --output-path=./public/build gutenberg=./src/gutenberg.js meta-box=./src/meta-box.js users-table=./src/users-table.ts",
        "build:blocks": "wp-scripts build --webpack-src-dir=./src-blocks --output-path=./public/build/blocks",
        "start:blocks": "wp-scripts start --webpack-src-dir=./src-blocks --output-path=./public/build/blocks",
        "pack": "bash ./bin/pack.sh"
    },
    "devDependencies": {
        "@types/wordpress__block-editor": "^15.0.6",
        "@types/wordpress__blocks": "^15.17.0",
        "@wordpress/block-editor": "^17.0.0",
        "@wordpress/blocks": "^15.25.0",
        "@wordpress/components": "^38.0.0",
        "@wordpress/data": "^10.52.0",
        "@wordpress/edit-post": "^8.52.0",
        "@wordpress/element": "^8.4.0",
        "@wordpress/plugins": "^7.52.0",
        "@wordpress/scripts": "^34.0.0",
        "prop-types": "^15.8.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "typescript": "^6.0.3",
        "underscore": "^1.13.8"
    }
}
